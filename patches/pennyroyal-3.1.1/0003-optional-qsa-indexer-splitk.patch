+# Local (split-K): aim for a few waves of CTAs, but keep >= _SPLITK_MIN_TILES key
+# tiles per CTA so short windows do not drown in per-CTA Q loads. Powers of two
+# bound the number of compiled kernel variants. SGLANG_QSA_MQA_SPLITK=1 disables
+# it; any other integer forces that split.
+_SPLITK_TARGET_CTAS = 4 * 188
+_SPLITK_MIN_TILES = 4
+_SPLITK_MAX = 64
+_SPLITK_BLOCK_N = 64
+
+
+def _qsa_mqa_prefill_split(padded_rows: int, keys: int, block_q: int) -> int:
+    forced = os.environ.get("SGLANG_QSA_MQA_SPLITK", "auto")
+    if forced != "auto":
+        return max(1, int(forced))
+    row_blocks = max(1, padded_rows // block_q)
+    max_by_tiles = max(1, -(-keys // _SPLITK_BLOCK_N) // _SPLITK_MIN_TILES)
+    want = min(_SPLITK_MAX, max_by_tiles, -(-_SPLITK_TARGET_CTAS // row_blocks))
+    split = 1
+    while split * 2 <= want:
+        split *= 2
+    return split
+
